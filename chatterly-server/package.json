{
  "name": "chatterly-server",
  "version": "1.0.0",
  "description": "Chatterly backend API server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "node dist/db/migrate.js && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.580.0",
    "@aws-sdk/s3-request-presigner": "^3.580.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.8.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "firebase-admin": "^12.1.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "sharp": "^0.33.4",
    "socket.io": "^4.7.5",
    "twilio": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
